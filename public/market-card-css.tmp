/* MARKET OVERVIEW CARDS */
.wp-block-column:has(.sp-price[data-market]){position:relative!important;width:100%!important;min-height:255px!important;padding:30px 28px 28px!important;box-sizing:border-box!important;background:linear-gradient(145deg,#111a33 0%,#0d162c 52%,#111b35 100%)!important;border:1px solid #26385f!important;border-radius:28px!important;box-shadow:0 18px 45px rgba(2,8,23,.42),inset 0 1px 0 rgba(255,255,255,.035)!important;overflow:hidden!important;transition:transform .25s ease,box-shadow .25s ease,border-color .25s ease!important}.wp-block-column:has(.sp-price[data-market]) .sp-price{display:block!important;margin:14px 0 18px!important;font-size:42px!important;line-height:1.08!important;font-weight:900!important;color:#7da2ff!important}.wp-block-column:has(.sp-price[data-market]) .sp-change.sp-positive{color:#4ade80!important}.wp-block-column:has(.sp-price[data-market]) .sp-change.sp-negative{color:#fb7185!important}.wp-block-column:has(.sp-price[data-market]) .sp-updated{display:block!important;font-size:13px!important;color:#8c96ab!important}.wp-block-column:has(.sp-price[data-market]) .sp-market-status{color:#22c55e!important;font-weight:900!important}.wp-block-column:has(.sp-price[data-market]) .sp-market-status:before{content:""!important;display:inline-block!important;width:8px!important;height:8px!important;border-radius:50%!important;background:#22c55e!important;box-shadow:0 0 10px rgba(34,197,94,.75)!important;margin-right:7px!important}